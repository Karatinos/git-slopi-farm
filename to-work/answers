#include <bits/stdc++.h>
using namespace std;

// Directions: 0=N,1=E,2=S,3=W (forward of initial heading is N)
static const int dx[4] = {0, 1, 0, -1};
static const int dy[4] = {1, 0, -1, 0};

int cur, fwd, bwd, lft, rgt;
int hx, hy, hd; // rover position and heading

map<pair<int,int>,int> mp;       // known heights
set<pair<int,int>> vis;          // cells we actually stood on
vector<pair<int,int>> path;      // DFS ancestors for equal-height plateau traversal

static void readSensor() {
    if (!(cin >> cur >> fwd >> bwd >> lft >> rgt)) exit(0);
}
static void sendCmd(const string& s) {
    cout << s << "\n";
    cout.flush();
}

// Move to the absolutely-oriented adjacent cell in direction d (0..3),
// using the cheapest command sequence, reading a reply after EVERY command.
static void moveTo(int d) {
    if (d == hd) {
        sendCmd("FW"); readSensor();
        hx += dx[hd]; hy += dy[hd];
    } else if (d == (hd + 2) % 4) {
        sendCmd("BW"); readSensor();
        hx += dx[d]; hy += dy[d];
    } else if (d == (hd + 3) % 4) {   // target is to the left
        sendCmd("RL"); readSensor();
        hd = (hd + 3) % 4;
        sendCmd("FW"); readSensor();
        hx += dx[d]; hy += dy[d];
    } else {                          // d == (hd+1)%4, target is to the right
        sendCmd("RR"); readSensor();
        hd = (hd + 1) % 4;
        sendCmd("FW"); readSensor();
        hx += dx[d]; hy += dy[d];
    }
    vis.insert({hx, hy});
    mp[{hx, hy}] = cur;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    readSensor();
    hx = 0; hy = 0; hd = 0;
    vis.insert({0, 0});

    while (true) {
        mp[{hx, hy}] = cur;
        // Absolute-direction heights
        int A[4];
        A[hd]           = fwd;
        A[(hd + 2) % 4] = bwd;
        A[(hd + 3) % 4] = lft;
        A[(hd + 1) % 4] = rgt;
        for (int d = 0; d < 4; ++d) mp[{hx + dx[d], hy + dy[d]}] = A[d];

        // Preference: forward, backward (cost 1), left, right (cost 2)
        int order[4] = {hd, (hd + 2) % 4, (hd + 3) % 4, (hd + 1) % 4};

        // 1) Ascend if any neighbour is exactly one unit higher.
        int chosen = -1;
        for (int i = 0; i < 4; ++i) { int d = order[i]; if (A[d] == cur + 1) { chosen = d; break; } }
        if (chosen != -1) {
            path.clear();
            moveTo(chosen);
            continue;
        }

        // 2) No ascent: traverse equal-height plateau toward a possible exit.
        int chosen2 = -1;
        for (int i = 0; i < 4; ++i) {
            int d = order[i];
            pair<int,int> nc = {hx + dx[d], hy + dy[d]};
            if (A[d] == cur && !vis.count(nc)) { chosen2 = d; break; }
        }
        if (chosen2 != -1) {
            path.push_back({hx, hy});
            moveTo(chosen2);
            continue;
        }

        // 3) Backtrack within the plateau.
        if (!path.empty()) {
            pair<int,int> par = path.back(); path.pop_back();
            int d = -1;
            for (int k = 0; k < 4; ++k)
                if (hx + dx[k] == par.first && hy + dy[k] == par.second) { d = k; break; }
            if (d != -1) { moveTo(d); continue; }
            path.clear();
        }

        // 4) Summit reached.
        sendCmd("SNP");
        return 0;
    }
}

